<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Inici - Classroom</title>
    <link id="favicon" rel="icon" type="image/x-icon" href="https://gstatic.com">
    <style>
        body { font-family: Arial, sans-serif; background: #121212; color: #fff; text-align: center; margin: 0; padding: 0; overflow-x: hidden; }
        .top-bar { background: #0000ff; color: white; padding: 10px; font-weight: bold; font-size: 14px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.5); }
        .container { padding: 40px 20px; }
        .box { background: #1e1e1e; padding: 30px; border-radius: 15px; display: inline-block; min-width: 450px; width: 90%; max-width: 900px; box-shadow: 0px 10px 25px rgba(0,0,0,0.7); border: 1px solid #333; position: relative; box-sizing: border-box; }
        .title-main { color: #00bcff; font-size: 28px; margin-bottom: 5px; font-weight: bold; text-shadow: 0 0 10px rgba(0,188,255,0.3); }
        .badge { background: #fff; color: #000; font-weight: bold; padding: 3px 8px; border-radius: 5px; font-size: 12px; vertical-align: middle; }
        
        input[type="email"], input[type="submit"], select { padding: 14px; margin: 10px 0; width: 95%; border-radius: 8px; border: 1px solid #444; background: #252525; color: white; box-sizing: border-box; font-size: 14px; }
        input[type="submit"] { background: #00e676; color: black; font-weight: bold; cursor: pointer; border: none; transition: 0.2s; }
        
        .games-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 15px; margin: 20px 0; padding: 10px; }
        .game-card { background: #252525; padding: 15px; border-radius: 10px; border: 1px solid #444; cursor: pointer; font-weight: bold; transition: 0.2s; font-size: 14px; display: flex; align-items: center; justify-content: center; min-height: 50px; color: white; }
        .game-card:hover { background: #00bcff; color: black; border-color: #00bcff; }
        
        .frame-wrapper { margin-top: 25px; border: 3px solid #333; border-radius: 12px; background: #000; overflow: hidden; position: relative; }
        iframe { width: 100%; height: 600px; border: none; background: #000; }
        
        .admin-panel { margin-top: 40px; border-top: 2px dashed #444; padding-top: 20px; background: #1a1a1a; padding: 20px; border-radius: 8px; text-align: left; }
    </style>
    <script>
        function cargarContenido(url) {
            var frame = document.getElementById('game-frame');
            frame.src = url;
            frame.scrollIntoView({ behavior: 'smooth' });
        }

        // Abre la pestaña about:blank e inyecta el motor intermediario seguro que bloquea el rastreo de historial
        function abrirAboutBlank(urlObjetivo) {
            var proxyUrl = window.location.origin + "/gsites.html?url=" + encodeURIComponent(urlObjetivo);
            var win = window.open('about:blank', '_blank');
            if (win) {
                win.document.open();
                win.document.write(`
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <title>Inici - Classroom</title>
                        <link rel="icon" type="image/x-icon" href="https://gstatic.com">
                        <style>html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; }</style>
                    </head>
                    <body>
                        <iframe src="${proxyUrl}" style="border:none; width:100%; height:100%; margin:0; padding:0;"></iframe>
                    </body>
                    </html>
                `);
                win.document.close();
            } else {
                alert("Por favor habilita las ventanas emergentes del navegador.");
            }
        }
    </script>
</head>
<body>

    <div class="top-bar">
        [10/16/2026] Servidores escudo activados. Navegación protegida sin registro de historial escolar.
    </div>

    <div class="container">
        <div class="box">
            <% if (!verContenido) { %>
                <div class="title-main">Welcome to Art Class Enhanced <span class="badge">early access!</span></div>
                <div class="subtext">It has been 2 years since the development of Art Class Enhanced started.</div>

                <form action="/acceder" method="POST">
                    <input type="email" name="email" placeholder="Introduce tu correo estudiantil para iniciar..." required>
                    <input type="submit" value="PLAY / ENTRAR">
                </form>
                <% if (mensaje) { %><p class="error"><%= mensaje %></p><% } %>
            <% } else { %>
                <div class="title-main">Art Class Enhanced <span class="badge">Live</span></div>

                <h3 style="color: #00bcff; margin-top: 20px; border-bottom: 1px solid #333; padding-bottom: 5px;">🎮 CATÁLOGO DE VIDEOJUEGOS</h3>
                <div class="games-grid">
                    <div class="game-card" onclick="cargarContenido('https://twoplayergames.org')">Basket Random</div>
                    <div class="game-card" onclick="cargarContenido('https://fnaf-online.io')">FNAF</div>
                    <div class="game-card" onclick="cargarContenido('https://subway-surfers.io')">Fuego y Agua</div>
                </div>

                <!-- LOS NUEVOS BOTONES CON MOTOR DE BÚSQUEDA ESCUDO (DuckDuckGo HTML no registra tu tráfico en el historial) -->
                <h3 style="color: #4285f4; margin-top: 25px; border-bottom: 1px solid #333; padding-bottom: 5px;">🔍 INTERNET Y VIDEO (MODO INVISIBLE CON ESCUDO)</h3>
                <div class="games-grid">
                    <div class="game-card" style="background: #4285f4; color: white;" onclick="abrirAboutBlank('https://duckduckgo.com')">🚀 Google/Internet Invisible</div>
                    <div class="game-card" style="background: #ff0000; color: white;" onclick="abrirAboutBlank('https://duckduckgo.com?q=site:youtube.com')">🚀 YouTube Invisible</div>
                </div>

                <div class="frame-wrapper">
                    <iframe id="game-frame" src="https://twoplayergames.org" allowfullscreen></iframe>
                </div>

                <% if (esAdmin) { %>
                    <div class="admin-panel">
                        <h3 style="color:#00bcff; margin-top:0;">🛠️ Consola del Administrador Suprema</h3>
                        <form action="/admin-accion" method="POST">
                            <input type="email" name="emailTarget" placeholder="Correo del alumno a gestionar" required style="width:100%;">
                            <select name="accion" style="width:100%;">
                                <option value="bloquear">🚫 Banear y meter en Lista Negra</option>
                                <option value="eliminar">♻️ Perdonar / Limpiar Registro</option>
                            </select>
                            <input type="submit" value="Ejecutar Orden Ejecutiva" style="width:100%; background:#dc3545; color:white;">
                        </form>
                    </div>
                <% } %>

                <br>
                <a href="/salir" style="color:#666; text-decoration:none; font-size:13px;">Cerrar sesión de estudiante</a>
            <% } %>
        </div>
    </div>
</body>
</html>
